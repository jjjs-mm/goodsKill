# Copy this file to .env before starting Docker Compose.
# Values below are for local development only. Do not reuse them in production.

TZ=Asia/Shanghai

MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_DATABASE=seckill
MYSQL_USER=seckill
MYSQL_PASSWORD=local-seckill-password
MYSQL_USERNAME=root
MYSQL_HOST=localhost
MYSQL_PORT=3306

REDIS_PASSWORD=local-redis-password
REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

NACOS_AUTH_TOKEN=MTIzNDU2Nzg5MGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6MQ==
NACOS_AUTH_IDENTITY_KEY=nacos
NACOS_AUTH_IDENTITY_VALUE=nacos
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_SERVER_ADDR=localhost:8848

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MONGODB_HOST=localhost
MONGODB_PORT=27017
ELASTICSEARCH_URIS=http://localhost:9200
DUBBO_REGISTRY_ADDRESS=zookeeper://localhost:2181
ZOOKEEPER_ADDRESS=localhost:2181

POSTGRES_DB=vector_db
POSTGRES_USER=goodskill
POSTGRES_PASSWORD=local-postgres-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-minio-password

# Replace this with a host/IP reachable by the Seata clients when enabling the
# experimental stack.
SEATA_IP=127.0.0.1
